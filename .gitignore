### Nix template
# Ignore build outputs from performing a nix-build or `nix build` command
result
result-*

!./CLAUDE.md

# tmux event/hubstaff logs
*.log

# Scratch / working files
tmp/

# Local overrides (not committed)
local.nix
*-local.nix
.devcell.toml

# linux-builder accidentally writes keys here if start script runs from repo cwd
keys/

# VM disk images — managed by nix-darwin linux-builder at /var/lib/linux-builder/
*.qcow2
*.img
*.iso
*.raw
